	"contentItems": {
		"agentixaction": null,
		"agentixagent": [
			{
				"description": "This Agent is designed to accelerate and simplify the analyst's workflow by converting complex data points,\ncase context, and event relationships into clear, actionable insights.\nIt understands the whole structure of a case, automatically highlights what matters most,\nand offers concise summaries that reduce noise and cognitive load.\n\nBeyond interpretation, it provides quick-access actions and guided steps that help analysts progress investigations\nwith confidence and consistency. Its strength comes from its ability to reason across diverse evidence,\nstitch narrative context, and translate technical signals into meaningful next moves - enabling a smoother,\nmore intuitive investigation experience end to end.",
				"name": "Case Investigation"
			},
			{
				"description": "Automates identity lifecycle enforcement, real-time containment on endpoints and networks, vulnerability and patch\ngovernance, asset intelligence upkeep, and end-to-end incident workflow coordination - delivering policy-driven\nremediation across the enterprise",
				"name": "IT",
				"supportedModules": [
					"agentix",
					"xsiam"
				]
			},
			{
				"description": "Manages Palo Alto Networks Panorama and Firewalls, as well as third-party network security products. Streamlines work\nfor network security engineers by performing configuration checks, policy optimization, vulnerability assessment,\ncertificate expiration monitoring as well as log analysis and threat response.",
				"name": "Network Security",
				"supportedModules": [
					"agentix",
					"xsiam",
					"edr"
				]
			},
			{
				"description": "Gathers fresh threat data, enriches indicators and vulnerabilities, links them to past or current incidents, and\npublishes clear briefings so the whole SOC acts on the latest attacker tactics",
				"name": "Threat Intel",
				"supportedModules": [
					"agentix",
					"xsiam",
					"xti"
				]
			},
			{
				"description": "Streamlines automation by generating and updating Python scripts from natural-language prompts,\napplying security best practices, and letting you explore or explain any part of the code.",
				"name": "Automation Engineer"
			},
			{
				"description": "Tier-2+ investigation agent for email security incidents.\n\nThis agent transforms raw email telemetry from XDR email issues (alerts) and\nMicrosoft Exchange Online Protection (EOP) and Microsoft Defender for Office 365 (MDO)\ntelemetry into a structured, evidence-based investigation narrative.\n\nIt reasons across multiple independent signals to determine:\n- Attacker intent\n- Identity abuse and infrastructure characteristics\n- Email filter and security control bypass indicators\n- User exposure and blast radius\n\nOptimized for:\n- Business Email Compromise (BEC) and impersonation\n- Credential phishing and OAuth abuse\n- Malware and payload delivery\n- Account takeover (ATO) and lateral abuse\n- Evasion and policy bypass scenarios",
				"name": "Email Investigation",
				"supportedModules": [
					"agentix",
					"email_security",
					"xsiam"
				]
			},
			{
				"description": "Unifies host-level containment, forensic collection, and remediation across all major EDR/XDR platforms while feeding\nevidence and status into the SOC's ticketing and collaboration stack",
				"name": "Endpoint Investigation",
				"supportedModules": [
					"agentix",
					"cloud",
					"cloud_runtime_security",
					"edr",
					"xsiam"
				]
			}
		],
