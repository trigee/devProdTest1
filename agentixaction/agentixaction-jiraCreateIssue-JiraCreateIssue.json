args:
- description: |
    Not recommended to use. A complete issue object in JSON format. This is intended for advanced users. When using this argument, all other arguments are ignored, and the entire issue must be defined in JSON — including required fields like `summary`, `project.key`, and `issuetype.id` or `issuetype.name`. Note: Only the project key is supported (not the project name). Example: {
      "fields": {
        "summary": "New issue summary",
        "project": {"key": "DEMO"},
        "issuetype": {"name": "Task"}
      }
    }
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: issue_json
  required: false
  type: string
  underlyingargname: issue_json
- description: The issue summary (short title of the issue). Required unless using
    `issue_json`.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: summary
  required: false
  type: string
  underlyingargname: summary
- description: The key of the Jira project to associate the issue with (e.g., "IT",
