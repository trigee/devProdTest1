args:
- description: |
    A comma-separated list of indicators to search for in relationships.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: entities
  required: false
  type: string
  underlyingargname: entities
- description: |
    A comma-separated list of entity types used to filter results. When provided, the response includes only entities that match the specified types. For example, if searching relationships for example.com and related_entity_types is set to IP, the results will only include related IP addresses, excluding other types like files or URLs. Note: Leave this field empty to return all related entity types. Options: Account, ASN, Attack Pattern, Campaign, CIDR, CVE, Domain, Email, File, Host, IP, IPv6, IPv6CIDR, Malware, Threat Actor.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: related_entity_types
  required: false
  type: string
  underlyingargname: related_entity_types
- description: |
    A comma-separated list of relationship types to filter relationships by. Options: attributed-by, communicated-with, compromises, delivered-by, detects, downloads, dropped-by, executed, exploits, hosted-on, indicator-of, is-also, mitigated-by, related-to, remediates, resolved-by, targeted-by, used-by, variant-of.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: relationships
  required: false
  type: string
  underlyingargname: relationships
- defaultvalue: "20"
  description: |
    Maximum number of results to return.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: limit
  required: false
  type: number
  underlyingargname: limit
- defaultvalue: "false"
  description: |
    Return detailed relationship attributes when true. When false, returns basic fields: name, Entity A/B values and types, relationship type.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: verbose
  required: false
  type: boolean
  underlyingargname: verbose
- defaultvalue: "false"
  description: |
    Include revoked relationships when true. When false, returns only active (non-revoked) relationships.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: revoked
  required: false
  type: boolean
  underlyingargname: revoked
