description: |
  Adds and/or removes assets from an AppSec application's override layer. Provide asset_ids_to_add, asset_ids_to_remove, or both. When both are supplied the ADD runs first. Returns an override batch action ID per operation for optional revert.
display: Cortex - Update Override Assets
isdetailsoverridden: false
locked: false
name: CortexUpdateOverrideAssets
outputs:
- description: |
    The override batch action ID for the ADD operation.
  disabled: false
  isdetailsoverridden: false
  name: Cas.UpdateOverrideAssets.add.actionId
  type: string
  underlyingoutputcontextpath: Cas.UpdateOverrideAssets.add.actionId
- description: |
    A comma-separated list of asset IDs that were successfully added to the application. Present only when asset_ids_to_add was provided.
  disabled: false
  isdetailsoverridden: false
  name: Cas.UpdateOverrideAssets.add.processed
  type: string
  underlyingoutputcontextpath: Cas.UpdateOverrideAssets.add.processed
- description: |
    A JSON-encoded list of assets that failed to be added. Each entry contains an assetId and a reason (e.g., excluded category, not found, already in app). Present only when asset_ids_to_add was provided
  disabled: false
  isdetailsoverridden: false
  name: Cas.UpdateOverrideAssets.add.failed
  type: string
  underlyingoutputcontextpath: Cas.UpdateOverrideAssets.add.failed
- description: |
    The override batch action ID for the REMOVE operation.
  disabled: false
  isdetailsoverridden: false
  name: Cas.UpdateOverrideAssets.remove.actionId
  type: string
  underlyingoutputcontextpath: Cas.UpdateOverrideAssets.remove.actionId
- description: |
    A comma-separated list of asset IDs to REMOVE from the application. Maximum of 50 assets per operation..
  disabled: false
  isdetailsoverridden: false
  name: Cas.UpdateOverrideAssets.remove.processed
  type: string
  underlyingoutputcontextpath: Cas.UpdateOverrideAssets.remove.processed
- description: |
    A JSON-encoded list of assets that failed to be removed. Each entry contains an assetId and a reason (e.g., not found, would remove all assets). Present only when asset_ids_to_remove was provided.
  disabled: false
  isdetailsoverridden: false
  name: Cas.UpdateOverrideAssets.remove.failed
  type: string
  underlyingoutputcontextpath: Cas.UpdateOverrideAssets.remove.failed
