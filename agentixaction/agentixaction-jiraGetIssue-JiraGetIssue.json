args:
- description: A comma-separated string of fields to return (Using the name or ID
    of the fields) to context data. Supplying `all` will return all the issue fields
    (which will include nested values), except for the comments, which can be retrieved
    using the !jira-get-comments command.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: fields
  required: false
  type: string
  underlyingargname: fields
- description: The issue ID (Issue ID or key is required).
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: issue_id
  required: false
  type: string
  underlyingargname: issue_id
- description: The issue key (Issue ID or key is required).
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: issue_key
  required: false
  type: string
  underlyingargname: issue_key
- description: Displays the headers in human readable format.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: headers
  required: false
  type: string
  underlyingargname: headers
- defaultvalue: "false"
  description: |
    If "true", retrieves the issue attachments and downloads the file to the tenant. Valid values are: true or false.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: get_attachments
  required: false
  type: boolean
  underlyingargname: get_attachments
- defaultvalue: "false"
  description: |
    If "true", expands the issue links (the linked issues and subtasks). Valid values are: true or false.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: expand_links
  required: false
  type: boolean
  underlyingargname: expand_links
