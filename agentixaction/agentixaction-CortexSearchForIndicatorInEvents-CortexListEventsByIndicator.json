args:
- description: |-
    A single raw indicator value to search for in the dataset logs. Must be only the indicator itself.
    Examples of valid values: "8.8.8.8", "evil.com", "44d88612fea8a8f36de82e1278abb02f", "user@example.com".
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: indicator
  required: true
  type: string
  underlyingargname: indicator
- defaultvalue: 7 days
  description: 'The time range for the search in relative date or range format. Examples:
    "1 day", "7 days", "3 weeks ago", "between 2021-01-01 12:34:56 +02:00 and 2021-02-01
    12:34:56 +02:00". Default is the last 7 days.'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: time_frame
  required: false
  type: string
  underlyingargname: time_frame
- defaultvalue: xdr_data
  description: The name of the dataset to search in. Common datasets include "xdr_data",
    "cloud_audit", and "identity". Default is "xdr_data".
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: data_set
  required: false
  type: string
  underlyingargname: data_set
- description: 'A descriptive label for this search query. Used to identify the results
    in the output. For example: "suspicious_ip_search" or "hash_lookup_results".'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: true
  name: query_name
  required: true
  type: string
  underlyingargname: query_name
