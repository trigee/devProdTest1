args:
- description: A comma-separated list of case IDs to filter by.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: case_id_list
  required: false
  type: string
  underlyingargname: case_id_list
- description: |
    A comma-separated list of case statuses to filter cases by. Options: new, in_progress, resolved.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: status
  required: false
  type: string
  underlyingargname: status
- description: |
    A comma-separated list of statuses to exclude from the results of the case search. Options: new, in_progress, resolved.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: not_status
  required: false
  type: string
  underlyingargname: not_status
- description: 'The start time for filtering according to case creation time. Supports
    ISO 8601 strings and relative free-text, For example: 7 days ago, 2023-06-15T10:30:00Z'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: gte_creation_time
  required: false
  type: date
  underlyingargname: gte_creation_time
- description: 'The end time for filtering according to case creation time. Supports
    ISO 8601 strings and relative free-text, For example: 7 days ago, 2023-06-15T10:30:00Z.'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: lte_creation_time
  required: false
  type: date
  underlyingargname: lte_creation_time
- description: |
    Sorts returned cases by the date/time that the case was created. Options: ASC, DESC.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: sort_by_creation_time
  required: false
  type: string
  underlyingargname: sort_by_creation_time
- defaultvalue: "false"
  description: |
    Filter cases by starred status. Options: true, false.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: starred
  required: false
  type: boolean
  underlyingargname: starred
- defaultvalue: "0"
  description: Page number (for pagination). The default is 0 (the first page).
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: page
  required: false
  type: number
  underlyingargname: page
- defaultvalue: "100"
  description: Maximum number of cases to return per page. The default and maximum
    value is 100.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: limit
  required: false
  type: number
  underlyingargname: limit
- defaultvalue: "false"
  description: |
    Whether to include enriched case data (issue IDs, network artifacts, file artifacts, notes, detection time, xdr url) in the response.
    Note: Enriched data is only supported for up to 10 cases. When more than 10 cases are returned, the action automatically falls back to standard case data.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: get_enriched_case_data
  required: false
  type: boolean
  underlyingargname: get_enriched_case_data
- description: |
    A comma-separated list of domains to filter by, For example: DOMAIN_SECURITY, DOMAIN_POSTURE, DOMAIN_IT, DOMAIN_HEALTH, DOMAIN_HUNTING.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: case_domain
  required: false
  type: string
  underlyingargname: case_domain
- description: |
    A comma-separated list of severity levels to filter by. Options: low, medium, high, critical.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: severity
  required: false
  type: string
  underlyingargname: severity
- description: A comma-separated list of Asset IDs related to the case to filter by.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: asset_ids
  required: false
  type: string
  underlyingargname: asset_ids
- description: A comma-separated list of Asset Group IDs related to the case to filter
    by.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: asset_groups
  required: false
  type: string
  underlyingargname: asset_groups
- description: A comma-separated list of hosts to filter by.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: hosts
  required: false
  type: string
  underlyingargname: hosts
- description: |
    A comma-separated list of assignee names or emails to filter by. Note: all values must be either names or emails - mixing both in the same request is not supported. Use the special values: "assigned" - to get all cases with assignees, "unassigned" - to get cases with no assignees.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: assignee
  required: false
  type: string
  underlyingargname: assignee
- description: A comma-separated list of names to filter by.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: case_name
  required: false
  type: string
  underlyingargname: case_name
- description: A comma-separated list of descriptions to filter by.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: case_description
  required: false
  type: string
  underlyingargname: case_description
- description: |
    A comma-separated list of tags to filter by, For example: "DOM:Security", "DOM:Posture", "DS:PANW/AI Security Posture", "DS:PANW/CAS Secret Scanner", ""DS:PANW/IoT Security", "DS:PANW/Secrets Scanner".
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: tag
  required: false
  type: string
  underlyingargname: tag
