args:
- description: |
    A JSON-encoded string representing an array of bare domain values to enrich.
    A domain is a plain hostname without any protocol or "www." prefix.
    Valid examples: "example.com", "openclaw.ai", "mail.google.com", "subdomain.evil.com"
    Invalid examples: "https://example.com" (has protocol — this is a URL), "www.example.com" (starts with "www." — this is a URL), "1.1.1.1" (IP address, not a domain)
    Example: '["example.com", "malicious-domain.org", "openclaw.ai"]'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: domain_list
  required: true
  type: string
  underlyingargname: domain_list
- defaultvalue: "true"
  description: Always set to true.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: external_enrichment
  required: false
  type: string
  underlyingargname: external_enrichment
- defaultvalue: "true"
  description: When set to true, the output will include additional fields about the
    domain. Default is true.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: additional_fields
  required: false
  type: string
  underlyingargname: additional_fields
