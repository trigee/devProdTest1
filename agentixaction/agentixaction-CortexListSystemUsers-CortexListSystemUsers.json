args:
- description: |
    A comma-separated list of user email addresses to filter the response by. Only users whose email matches an entry in the list are returned.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: emails
  required: false
  type: string
  underlyingargname: emails
- description: |
    A comma-separated list of user names (full or partial) to filter the response by. Each entry is matched case-insensitively against the user's first and last name combined; every whitespace-separated word in an entry must appear somewhere in the user's name for that entry to match (so "John Doe" matches a user whose first name is John and last name is Doe, in either order, but not "John Smith"). Multiple entries are OR-ed, so "John Doe,Mary Watson" returns either user. Combine with the emails filter to narrow further.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: names
  required: false
  type: string
  underlyingargname: names
- defaultvalue: "50"
  description: |
    Maximum number of users to return. Default value is 50.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: limit
  required: false
  type: number
  underlyingargname: limit
