  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: expirationStatus
  required: false
  type: string
  underlyingargname: expirationStatus
- description: 'A comma-separated list of types of indicators to search. Options:
    Account, ASN, Attack Pattern, Campaign, CIDR, CVE, Domain, Email, File, Host,
    IP, IPv6, IPv6CIDR, Malware, Threat Actor.'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: type
  required: false
  type: string
  underlyingargname: type
- description: A comma-separated list of IDs of issues linked to the indicator.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: IssuesIDs
  required: false
  type: string
  underlyingargname: IssuesIDs
