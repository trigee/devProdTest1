description: Retrieves resolution status information for a specific case, including
  pending playbook tasks, active playbooks, completed playbooks, and recommended playbooks.
display: Cortex - Get Case Resolution Statuses
isdetailsoverridden: false
locked: false
name: CortexGetCaseResolutionStatuses
outputs:
- description: 'The resolution status of the item. Options are "done", "inProgress",
    "pending", "recommended". Note: The "pending" status is relevant only for tasks
    within a playbook. A task is considered pending primarily when the playbook is
    stopped and waiting for user input on a manual task. It can also be considered
    pending if the playbook is new and has not yet started, is paused, or is stopped.
    In a broader sense, tasks within an in-progress playbook might also be considered
    pending if they are awaiting completion.'
  disabled: false
  isdetailsoverridden: false
  name: Core.CaseResolutionStatus.category
  type: string
  underlyingoutputcontextpath: Core.CaseResolutionStatus.category
- description: 'The type of item.  Options are: "playbook" or "playbookTask".'
  disabled: false
  isdetailsoverridden: false
