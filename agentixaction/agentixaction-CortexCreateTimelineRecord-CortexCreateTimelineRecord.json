args:
- description: The ID of the case to add the timeline record to.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: case_id
  required: true
  type: string
  underlyingargname: case_id
- description: |-
    The Type of the timeline record.
    Use "Case activity" for analyst notes, manual findings, or case management actions.
    Use "Detection" for detection-related events or issues.
    Use "Response" for response actions taken by an analyst or automation.
    Options: Case activity, Detection, Response.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: record_type
  required: true
  type: string
  underlyingargname: record_type
- description: The Record Name or title of the timeline record. This is the main label
    shown in the timeline.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: record_name
  required: true
  type: string
  underlyingargname: record_name
- description: |-
    When the event actually occurred. Use this to backdate a record.
    Defaults to the current time if omitted.
    Supports relative and absolute dates, for example: 7 days ago, 2023-06-15T10:30:00Z, 13/8/2025.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: occurred_at
  required: false
  type: date
  underlyingargname: occurred_at
- defaultvalue: "false"
  description: Whether to mark this record as Evidence. Set to true to flag it as
    evidence, false to leave it as a regular record. Defaults to false.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: is_evidence
  required: false
  type: boolean
  underlyingargname: is_evidence
- description: An Evidence Comment explaining why this record is being marked as evidence.
    Only used when is_evidence is true.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: evidence_comment
  required: false
  type: string
  underlyingargname: evidence_comment
- description: A comma-separated list of Tags to attach to the timeline record.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: tags
  required: false
  type: string
  underlyingargname: tags
- description: A Description of the timeline record providing context about the event.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: description
  required: false
  type: string
  underlyingargname: description
- description: A Query Execution ID to link XQL query results to this timeline record.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: xql_execution_id
  required: false
  type: string
  underlyingargname: xql_execution_id
