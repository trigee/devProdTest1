args:
- description: |
    A JSON-encoded string representing an array of URL values to enrich.
    A URL must include a protocol/scheme (http://, https://, ftp://) or start with "www." or "ftp.".
    Valid examples: "https://example.com", "http://malicious.com/payload", "www.example.com", "www.example.com/path", "ftp://files.example.com"
    Invalid examples: "example.com", "openclaw.ai", "google.com" (bare hostnames without protocol or "www." are domains, not URLs), "1.1.1.1" (IP address, not a URL)
    Example: '[\"https://example.com/page\", \"http://malicious.com/payload\", \"www.example.com\"]'
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: url_list
  required: true
  type: string
  underlyingargname: url_list
- defaultvalue: "true"
  description: Always set to true.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: external_enrichment
  required: false
  type: string
  underlyingargname: external_enrichment
- defaultvalue: "true"
  description: When set to true, the output will include additional fields about the
    URL. Default is true.
  disabled: false
  hidden: false
  isdetailsoverridden: false
  isgeneratable: false
  name: additional_fields
  required: false
  type: string
  underlyingargname: additional_fields
